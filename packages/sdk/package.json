{
  "name": "@industrial-agent-harness/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Project-bound Node client and stdio JSON-RPC for the headless Industrial Harness CLI",
  "main": "src/index.cjs",
  "types": "src/index.d.cts",
  "exports": {
    ".": {
      "types": "./src/index.d.cts",
      "require": "./src/index.cjs",
      "default": "./src/index.cjs"
    }
  },
  "bin": {
    "industrial-harness-rpc": "src/rpc.cjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs"
  }
}
